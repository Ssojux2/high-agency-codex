{
  "description":"High Agency Git-baseline tracking, targeted verification guard, conditional final diff review, and bounded continuation.",
  "hooks":{
    "UserPromptSubmit":[{"hooks":[{"type":"command","command":"python3 ${PLUGIN_ROOT}/hooks/verification_state.py","timeout":2}]}],
    "PostToolUse":[{"matcher":"Bash|Edit|Write|apply_patch","hooks":[{"type":"command","command":"python3 ${PLUGIN_ROOT}/hooks/verification_state.py","timeout":2}]}],
    "Stop":[{"hooks":[{"type":"command","command":"python3 ${PLUGIN_ROOT}/hooks/stop_loop.py","timeout":3,"statusMessage":"Checking High Agency completion"}]}]
  }
}
